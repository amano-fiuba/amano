# Base de datos (PostgreSQL)
POSTGRES_DB=amano
POSTGRES_USER=amano
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_PORT=5432

# Autenticación (JWT de sesión; HttpOnly SameSite=Strict, expiración 24 h)
JWT_SECRET=cambiar_este_secreto
JWT_EXPIRATION=86400

# --- Solo para producción (Raspberry Pi); en tu computadora dejalas comentadas ---
# COMPOSE_FILE=compose.prod.yaml
# DATA_DIR=/mnt/hdd/apps/amano-data
# DOMAIN=amano-fiuba.duckdns.org
