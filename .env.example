# Base de datos (PostgreSQL)
POSTGRES_DB=amano
POSTGRES_USER=amano
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_PORT=5432

# Autenticación (JWT de sesión; HttpOnly SameSite=Strict, expiración 24 h)
JWT_SECRET=cambiar_este_secreto
JWT_EXPIRATION=86400

# --- Correo de verificación (feature 002) ---
# SMTP para el envío manual en dev/demo. Requiere una cuenta Google con 2FA y una
# "contraseña de aplicación" (MAIL_PASSWORD). Los tests automatizados NUNCA usan
# Gmail real: corren contra GreenMail en proceso (research.md D9, regla del equipo).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-cuenta-de-correo@example.com
MAIL_PASSWORD=cambiar-contrasena-de-aplicacion-de-gmail
# Base pública del enlace del correo: ${APP_BASE_URL}/verify-email?token=...
#   dev server de Vite (npm run dev): http://localhost:5173
#   compose dev (docker compose up): http://localhost:8081
#   prod (Caddy):                     https://tu-dominio
APP_BASE_URL=http://localhost:5173

# --- Solo para producción (Raspberry Pi); en tu computadora dejalas comentadas ---
# COMPOSE_FILE=compose.prod.yaml
# DATA_DIR=/mnt/hdd/apps/amano-data
# DOMAIN=amano-fiuba.duckdns.org
